# Nusxa oling: cp .env.example .env  (.env git'ga tushmaydi)

# BotFather bergan token (MAXFIY)
API_TOKEN=

# Firebase service account: JSON matnini bitta qatorda (Render uchun qulay)...
FIREBASE_CREDENTIALS_JSON=
# ...yoki fayl yo'li (lokal ishlash uchun)
FIREBASE_CREDENTIALS_FILE=serviceAccountKey.json
FIREBASE_DB_URL=https://mmebel-bot-default-rtdb.europe-west1.firebasedatabase.app

# Serverning tashqi manzili (Render avtomatik RENDER_EXTERNAL_URL beradi)
PUBLIC_URL=

# Doimiy adminlar (Telegram ID, vergul bilan). Bazadagi roldan qat'i nazar admin bo'ladi.
OWNER_IDS=

# Tashqi cron (cron-job.org) uchun maxfiy kalit. Bo'sh bo'lsa /cron/* o'chirilgan.
CRON_SECRET=
# Telegram webhook maxfiy kaliti (bo'sh bo'lsa tokendan avtomatik hosil qilinadi)
WEBHOOK_SECRET=

# Lokal ishlab chiqishda webhook o'rniga polling
USE_POLLING=0
KEEP_AWAKE=1
